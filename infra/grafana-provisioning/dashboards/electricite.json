        "graphMode": "none",
        "justifyMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "" },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "kWh",
          "decimals": 0
        }
      },
      "targets": [
        {
          "query": "from(bucket: \"electricite\")\n  |> range(start: -7d)\n  |> filter(fn: (r) => r._measurement == \"electricite_index\")\n  |> filter(fn: (r) => r._field == \"valeur\")\n  |> last()\n  |> group()\n  |> sum()\n  |> map(fn: (r) => ({ r with _value: r._value / 1000.0 }))\n  |> yield(name: \"total\")",
          "refId": "A"
