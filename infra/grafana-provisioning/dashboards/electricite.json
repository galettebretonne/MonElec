      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "decimals": 0,
          "custom": {
            "showPoints": "never",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 30,
            "stacking": { "mode": "normal" }
          }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Jour Bleu H. Creuse" }, "properties": [{ "id": "color", "value": { "fixed": "#00FFFF" } }] },
          { "matcher": { "id": "byName", "options": "Jour Bleu H. Pleine" }, "properties": [{ "id": "color", "value": { "fixed": "#0000FF" } }] },
