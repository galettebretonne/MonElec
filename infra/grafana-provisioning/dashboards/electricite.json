{
  "__inputs": [],
  "__requires": [],
  "title": "MonElec - Suivi Consommation",
  "version": 3,
  "timezone": "Europe/Paris",
  "schemaVersion": 39,
  "tags": ["monelec", "electricite"],
  "refresh": "5m",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "title": "Puissance",
      "type": "stat",
      "gridPos": { "h": 3, "w": 4, "x": 0, "y": 1 },
      "datasource": "InfluxDB",
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "" },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 3000 },
              { "color": "red", "value": 6000 }
            ]
          }
        }
      },
      "targets": [
        {
          "query": "from(bucket: \"electricite\")\n  |> range(start: -10m)\n  |> filter(fn: (r) => r._measurement == \"electricite_index\")\n  |> filter(fn: (r) => r._field == \"valeur\")\n  |> difference()\n  |> filter(fn: (r) => r._value >= 0)\n  |> map(fn: (r) => ({ r with _value: r._value * 60.0 }))\n  |> sum()\n  |> yield(name: \"total\")",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Aujourd'hui",
      "type": "stat",
      "gridPos": { "h": 3, "w": 4, "x": 4, "y": 1 },
      "datasource": "InfluxDB",
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "" },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "kWh",
          "decimals": 1
        }
      },
      "targets": [
        {
          "query": "from(bucket: \"electricite\")\n  |> range(start: today())\n  |> filter(fn: (r) => r._measurement == \"electricite_index\")\n  |> filter(fn: (r) => r._field == \"valeur\")\n  |> increase()\n  |> filter(fn: (r) => r._value >= 0)\n  |> sum()\n  |> map(fn: (r) => ({ r with _value: r._value / 1000.0 }))\n  |> yield(name: \"today\")",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
