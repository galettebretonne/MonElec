        {
          "query": "from(bucket: \"electricite\")\n  |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"electricite_index\")\n  |> filter(fn: (r) => r._field == \"valeur\")\n  |> increase()\n  |> filter(fn: (r) => r._value >= 0)\n  |> sum()\n  |> map(fn: (r) => ({ r with _value: r._value / 1000.0 }))\n  |> yield(name: \"month\")",
          "refId": "A"
